+UFSRVResult *
+DbBackendInstantiateSession(Session *sesn_ptr_transient, const UfsrvUid *ufsrvuid)
+{
+  const char				  *scratch;
+
+  unsigned long userid = UfsrvUidGetSequenceId(ufsrvuid);
+  struct json_object	*jobj_account = DbGetAccountInJsonByUserId(userid);
+  if (unlikely(IS_EMPTY(jobj_account)))	_RETURN_RESULT_SESN(sesn_ptr_transient, NULL, RESULT_TYPE_ERR, RESCODE_USER_INITIALISED)
+
+  struct json_object	*jobj_datauser = DbGetAccountUserDataInJsonByUserId(userid);
