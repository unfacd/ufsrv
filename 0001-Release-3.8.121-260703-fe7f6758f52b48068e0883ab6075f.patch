+/**
+ * @brief A simple url path tokeniser that splits on '/'. It understands escaped '/' and will process past them. Tokens are index at 0. Trailing '/' are ignored.
+ * User is responsible for ensuring sufficient allocation of tokens storage.
+ * Path such as "1/2//3/4/5/" will contain an empty, but otherwise valid token at third token (index 2).
+ * @param str String containing the full path to be tokenised. This string is considered sacrificial and as such will be dotted with null chars to demark tokens. Pass a copy if you want to preserve the original.
+ * @param tokens pre allocated array to hold individual tokenised strings which are simply pointers to demarked address locations in @param str
+ * @param tokens_sz_hint maxmmum number of tokens to be processed. The tokeniser mau process less.
+ */
+void TokeniseUrlParams(char *str, UrlParamsDescriptor *tokens, size_t tokens_sz_hint)
+{
+  char *p;
+  size_t counter = 0;
+  UrlParamToken *param = tokens->tokens[counter];
+
+  p = str;
+  if (*p == '/') p++;
+  param->token = p;
+
+  while (1 != 2) {
+    if (*p == '\0') {
+      break;
+    }
+    if (*p == '\\' && *(p + 1) == '/') {
+      p += 2;
+      continue;
+    }
+    if (*p == '/') {
+      *p = '\0';
+
+      if (counter + 1 == tokens_sz_hint ||
+          *(p + 1) == '\0') { //ignore case where path ends with a trailing '/'
+        break;
+      }
+      param = tokens->tokens[++counter];
+      param->token = p + 1;
+    }
+
+    p++;
+  }
+
+  tokens->tokens_sz = counter + 1; //return true index size (ie no 0-indexed)
+
+}
