+  request_error:
+  onion_response_set_code(HTTPSESN_RESPONSE_PTR(http_ptr), 409);
+  onion_response_write(instance_sesn_ptr, HTTPSESN_RESPONSE_PTR(http_ptr), err, strlen(err));
+
+  request_processed:
+  return OCS_PROCESSED;
 
