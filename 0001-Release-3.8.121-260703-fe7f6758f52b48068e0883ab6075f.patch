+     `when` datetime DEFAULT CURRENT_TIMESTAMP COMMENT 'Timestamp at which state changed',
+     PRIMARY KEY (`release_id`, `uuid`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8 ROW_FORMAT=COMPACT;
