+    if (IS_OK(ProvideUserRecordFromSessionInProto(sesn_ptr_aux, urec_ptr_aux, PROTO_USER_RECORD_MINIMAL, false))) {
+      user_records[processed_counter] = urec_ptr_aux;
+    } else continue;
+
+    processed_counter++;
+  }//for
+
+  if (fence_call_flags&FENCE_CALLFLAG_LOCK_FENCE) {
+    if (!fence_lock_already_owned)	FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, f_ptr, SESSION_RESULT_PTR(sesn_ptr_this));
+  }
+
+#ifdef __UF_TESTING
+  syslog(LOG_DEBUG, "%s (pid:'%lu', fid:'%lu', users_sz:'%d'): FINISHED PROTO representation.", __func__, pthread_self(), FENCE_ID(f_ptr), FENCE_LINK_JOINING_USER_SESSION_LIST_SIZE(f_ptr));
+#endif
+
+  desc_ptr->records_sz = processed_counter;
+  desc_ptr->user_records = user_records;
+
+  return desc_ptr;
+
