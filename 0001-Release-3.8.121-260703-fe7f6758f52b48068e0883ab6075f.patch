+    jobj_userprefs = (json_object *)SESSION_RESULT_USERDATA(sesn_ptr_transient);
+    PopulateUserPrefsFromRawJson(sesn_ptr_transient, jobj_userprefs);
+    json_object_put(jobj_userprefs);
+  }
+
+  GetAccountAttributes(jobj_account,  sesn_ptr_transient);////todo 9/3/25 devops: does this conflict with PopulateUserPrefsFromRawJson() above? nickname, avatar are reloaded here
+  //Add more fields...
+
+  json_object_put(jobj_account);
+  json_object_put(jobj_datauser);
+
+  _RETURN_RESULT_SESN(sesn_ptr_transient, sesn_ptr_transient, RESULT_TYPE_SUCCESS, RESCODE_USER_INITIALISED)
+
+}
