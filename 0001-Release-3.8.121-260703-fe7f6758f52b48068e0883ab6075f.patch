+
+typedef struct DistinctArrayDescriptor {
+    size_t block_allocated_sz; ///< as variable array for block storage grows, this indicates how much storage in multiple of \p block_storage_unit_sz units available
+    size_t collection_allocated_sz;
+    size_t block_storage_unit_sz; ///< individual storage unit. Fixed size per hashmap.
+    size_t storage_slot_offset;
+    __unused size_t storage_slot_idx; ///< track current index where last entry is saved. Can be different from allocated size, eg due to deletion and preserving of allocation slot.
+} DistinctArrayDescriptor;
+
+typedef struct DistinctArray {
+    HashTable hashTable;
+    DistinctArrayDescriptor distinct_array_descriptor;
+    struct VariableBlock {
+        size_t size; ///< actual size of stored value-slots
+        uint8_t *value[]; ///< variable array for storing values for keys
+    } *value_block_storage;
+    struct VariableBlockIndex {
+        size_t size;
+        uint8_t *value_index[]; ///< for each individual value stored in block, save head pointer
+    } *stored_value_idx;
+} DistinctArray;
