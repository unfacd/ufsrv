+
+  //AA-
+  //we do that seperately in reset lifecycle
+
+  int rs = onion_response_free(instance_sesn_ptr, SESSION_HTTPSESN_RESPONSE_PTR(sesn_ptr));
+
+  //No error (but we could still need more data)
+  if (hs >= 0 && rs == OCS_KEEP_ALIVE) {
