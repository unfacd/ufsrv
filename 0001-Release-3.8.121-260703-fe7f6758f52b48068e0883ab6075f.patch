+/**
+ * @brief User rejected an incoming invite
+ */
+inline static UFSRVResult *
+_CommandControllerFenceInviteRejectedSet(InstanceHolderForSession *instance_sesn_ptr, WebSocketMessage *wsm_ptr_received, DataMessage *data_msg_ptr)
+{
+  bool 									fence_already_locked = false;
+  InstanceHolderForFenceStateDescriptor *instance_fstate_ptr;
+  Fence                                 *f_ptr = NULL;
+  InstanceHolderForFence                *instance_f_ptr = NULL;
+  FenceStateDescriptor	                *fstate_ptr;
+  FenceCommand					                *fcmd_ptr = data_msg_ptr->ufsrvcommand->fencecommand;
+
+#define _FENCE_CALL_FLAGS_INVITE_REJECTED	(FENCE_CALLFLAG_CHECK_FENCEOWNERSHIP|FENCE_CALLFLAG_KEEP_FENCE_LOCKED)
+
+  Session *sesn_ptr = SessionOffInstanceHolder(instance_sesn_ptr);
+
+  //locks by default
+  IsUserAllowedToRejectFence(sesn_ptr,fcmd_ptr->fences[0]->fid, fcmd_ptr->fences[0]->cname, &fence_already_locked, _FENCE_CALL_FLAGS_INVITE_REJECTED);
+
+  if (SESSION_RESULT_TYPE_ERROR(sesn_ptr))	{
+    int 	rescode		=	SESSION_RESULT_CODE(sesn_ptr);
+
+    if (!SESSION_RESULT_CODE_EQUAL(sesn_ptr, RESCODE_FENCE_DOESNT_EXIST)) {
+      //FENCE LOCKED...
+      if (SESSION_RESULT_CODE(sesn_ptr) == RESCODE_FENCE_OWNERSHIP) {
+//        instance_f_ptr = (InstanceHolderForFence *)SESSION_RESULT_USERDATA(sesn_ptr);//this branch is not supported
+//        f_ptr		=	FenceOffInstanceHolder(instance_f_ptr);
+//
+//        HandleFenceCommandError(&(InstanceContextForSession){instance_sesn_ptr, sesn_ptr}, fstate_ptr, wsm_ptr_received, data_msg_ptr, rescode, fcmd_ptr->header->command, NULL);
+      } else { //RESCODE_FENCE_MEMBERSHIP //user not on invite list
+        instance_f_ptr =  (InstanceHolderForFence *)SESSION_RESULT_USERDATA(sesn_ptr);
+        f_ptr		=	FenceOffInstanceHolder(instance_f_ptr);
+        HandleFenceCommandError(&(InstanceContextForSession) {instance_sesn_ptr,
+                                                              sesn_ptr}, &((FenceStateDescriptor) {.instance_holder_fence=instance_f_ptr}), wsm_ptr_received, data_msg_ptr, rescode, fcmd_ptr->header
+                                                                                                                                                                                             ->command, NULL);
+      }
+
+      if (!fence_already_locked)	FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, f_ptr, SESSION_RESULT_PTR(sesn_ptr));
+      goto return_catch_all;
+    }
+
+    return_catch_all:
+    _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, rescode)
+  }
+
+  //>>> FENCE SHOULD BE IN RW LOCKED STATE
+
+  instance_f_ptr = (InstanceHolderForFence *)SESSION_RESULT_USERDATA(sesn_ptr);
+  f_ptr =  FenceOffInstanceHolder(instance_f_ptr);
+  if (unlikely(IS_EMPTY((instance_fstate_ptr = IsUserMemberOfThisFence(SESSION_INVITED_FENCE_LIST_PTR(sesn_ptr), f_ptr, false)))))	goto return_error_not_invited;
+
+  fstate_ptr          = FenceStateDescriptorOffInstanceHolder(instance_fstate_ptr);
+  UfsrvUid uid_invited_by = {0};
+  memcpy(&uid_invited_by, &(fstate_ptr->invited_by), sizeof(UfsrvUid));
+
+  FenceEvent fence_event = {0};	fence_event.event_type = EVENT_TYPE_FENCE_USER_INVITEREJECTED;
+  RemoveUserFromInvitedList(instance_sesn_ptr, fstate_ptr, &fence_event, FENCE_CALLFLAG_WRITEBACK_DATA_TO_BACKEND);
+
+  InstanceContextForFence fence_context = {.f_ptr=f_ptr, .instance_f_ptr=instance_f_ptr, .is_locked=true, .lock_already_owned=fence_already_locked};
+  MarshalFenceInvitationRejected(&(InstanceContextForSession){instance_sesn_ptr, sesn_ptr}, fstate_ptr, &fence_context, &uid_invited_by, &fence_event, wsm_ptr_received, data_msg_ptr, 0);
+  if (fence_context.is_locked && !fence_context.lock_already_owned)	FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, FENCESTATE_FENCE(fstate_ptr), SESSION_RESULT_PTR(sesn_ptr));
+
+  return SESSION_RESULT_PTR(sesn_ptr);
+
+  return_error_not_invited://no retrieved FenceStateDescriptor
+  HandleFenceCommandError(&(InstanceContextForSession) {instance_sesn_ptr,
+                                                        sesn_ptr}, &((FenceStateDescriptor) {.instance_holder_fence=instance_f_ptr}), wsm_ptr_received, data_msg_ptr, RESCODE_FENCE_MEMBERSHIP, fcmd_ptr->header->command, NULL);
+  if (!fence_already_locked)	FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, f_ptr, SESSION_RESULT_PTR(sesn_ptr));
+  return SESSION_RESULT_PTR(sesn_ptr);
+
+
+#undef _FENCE_CALL_FLAGS_INVITE_REJECTED
+}
