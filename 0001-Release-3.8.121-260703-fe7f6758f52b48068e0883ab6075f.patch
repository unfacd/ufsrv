+/**
+ * @brief Provide raw json node, describing donations.
+ * @param sesn_ptr user session for donations
+ * @return raw json
+ * @dynamic_memory EXPORTS "json_object *'
+ */
+__attribute__ ((nonnull(1), access(read_only, 1), ownership_returns(malloc)))
