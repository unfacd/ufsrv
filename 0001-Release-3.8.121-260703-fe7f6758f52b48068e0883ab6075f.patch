+__pure bool IsFencePublic(const Fence *f_ptr)
+{
+  if (F_ATTR_IS_SET(f_ptr->attrs, F_ATTR_GUARDIANFENCE)) return false;
+  return F_ATTR_IS_SET(f_ptr->attrs, F_ATTR_BASEFENCE) || !F_ATTR_IS_SET(f_ptr->attrs, F_ATTR_PRIVATE);
+}
