+  //>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
+
+  struct _h_connection *db_ptr = InitialiseDbBackend();
+  if (db_ptr) {
+    //todo: to be removed once thread_local implementation below is complete
