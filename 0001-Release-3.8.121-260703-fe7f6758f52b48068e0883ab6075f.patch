+//	redis_ptr = (*pers_ptr->send_command)(sesn_ptr, command_buf);
+//
+//	if (redis_ptr)	freeReplyObject(redis_ptr);
+
+  DbBackendInsertUfsrvEvent((UfsrvEvent *)fe_ptr);
+
+  return fe_ptr;
