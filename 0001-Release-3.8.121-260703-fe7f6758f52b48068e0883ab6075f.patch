+inline static UFSRVResult *
+_MarshalIntroMessageUserResponse(InstanceContextForSession *ctx_sesn_ptr, InstanceHolderForSession *instance_sesn_ptr_target, WebSocketMessage *wsm_ptr_received, DataMessage *data_msg_ptr_received, UfsrvEvent *event_ptr)
+{
