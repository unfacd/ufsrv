+	MarshalMessageEnvelopeForFence	envelope_marshal = {	\
+			.ufsrv_command_wire	=	&ufsrv_command_wire,	\
+			.envelope						=	&command_envelope,	\
+			.fence_command			=	&fence_command,	\
