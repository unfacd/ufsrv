-	InstanceHolderForSession				*instance_sesn_ptr_carrier			=	InstantiateCarrierSession (NULL, WORKERTYPE_UFSRVWORKER, SESSION_CALLFLAGS_EMPTY);
-	if (IS_EMPTY(instance_sesn_ptr_carrier))	{
-	  rc = -4;
-	  goto return_final;
