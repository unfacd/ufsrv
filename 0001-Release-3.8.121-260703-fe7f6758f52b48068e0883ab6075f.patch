+/**
+ * @brief For re-registyration purpose
+ * @param pin_hash_to_check aragon2 hashed pin
+ * @param username Since this is done at registration (where ufsrvuid is not known yet) signup username is used.
+ * @return true if matching
+ */
+bool
+IsKbsPinHashMatching(const char *pin_hash_to_check, const char *username)
+{
+  char *pin_hash_stored = GetAccountRegistrationPinHashByUsername(username);
+  bool is_matching = IS_STR_LOADED(pin_hash_stored) && (0 == strncmp(pin_hash_stored, pin_hash_to_check, MEDIUMBUF));
+  free(pin_hash_stored);
+
+  return is_matching;
+}
