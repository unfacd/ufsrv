+    _exit (-1);
+  }
+
+  syslog(LOG_INFO, "%s : SUCCESS: Initialised UserMessage Cache Backend for Ufsrv Worker thread: '%lu'...", __func__, pthread_self());
+
+  //>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
+
+  FenceCacheBackend *per_ptr_fence = InitialiseCacheBackendFence(NULL);
+  if (per_ptr_fence) {
