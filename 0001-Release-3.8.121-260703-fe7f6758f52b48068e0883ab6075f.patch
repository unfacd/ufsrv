+
+/**
+ * Set receive handler on a UDP Socket
+ *
+ * @param us  UDP Socket
+ * @param rh  Receive handler
+ * @param arg Handler argument
+ */
+void udp_handler_set(struct udp_sock *us, udp_recv_h *rh, void *arg)
+{
+	if (!us)
+		return;
+
+	us->rh  = rh ? rh : dummy_udp_recv_handler;
+	us->arg = arg;
+}
