+/**
+ * @brief Main controller for Intro messages user response messages. A response message is sent to the user who originated the intro request.
+ * @param sesn_ptr
+ * @param wsm_ptr_orig
+ * @param data_msg_ptr
+ * @param mqp_ptr
+ * @return
+ * @locks sesn_ptr_target
+ * @locked sesn_ptr
+ *
+ */
+inline static UFSRVResult *
+_UfsrvCommandControllerMessageIntroUserResponse(InstanceContextForSession *ctx_sesn_ptr, WebSocketMessage *wsm_ptr_received, DataMessage *data_msg_ptr, ParsedMessageDescriptor *msg_descriptor_ptr_out)
+{
+  MessageCommand	*msgcmd_ptr;
+  UFSRVResult 	*res_ptr			= NULL;
+
+  Session *sesn_ptr = ctx_sesn_ptr->sesn_ptr;
+
+  msgcmd_ptr = data_msg_ptr->ufsrvcommand->msgcommand;
+
+  if (unlikely(IS_EMPTY(msgcmd_ptr->intro))) {
+    syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p'}: ERROR: COMMAND CONTAINED NO INTRO RECORD...", __func__, pthread_self(), THREAD_CONTEXT_PTR, sesn_ptr);
+
+    _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_PROG_NULL_POINTER)
+  }
+
+  //"to" must be ufsrvuid (no handle type for responses)
+  IntroMessageRecord *record_ptr = msgcmd_ptr->intro;
+  if (msgcmd_ptr->header->eid_client <= 0 ) {
+    syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p', eid_client:'%lu'}: ERROR: EID_CLIENT NOT SET...", __func__, pthread_self(), THREAD_CONTEXT_PTR, sesn_ptr, msgcmd_ptr->header->eid_client);
+
+    _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_PROG_NULL_POINTER)
+  }
+
+  if (!IS_STR_LOADED(record_ptr->to)  || strlen(record_ptr->to) > CONFIG_MAX_UFSRV_ID_ENCODED_SZ) {
+    syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p'}: ERROR: COMMAND CONTAINED INVALID TO-UFSRVUID...", __func__, pthread_self(), THREAD_CONTEXT_PTR, sesn_ptr);
+
+    _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_PROG_NULL_POINTER)
+  }
+
+  //todo: check: originator must match the sender of this message to ensure receiving end has a proper IntroResponse message
+  if (!IS_STR_LOADED(record_ptr->originator)  || strlen(record_ptr->originator) > CONFIG_MAX_UFSRV_ID_ENCODED_SZ) {
+    syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p'}: ERROR: COMMAND CONTAINED INVALID ORIGINATOR-UFSRVUID...", __func__, pthread_self(), THREAD_CONTEXT_PTR, sesn_ptr);
+
+    _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_PROG_NULL_POINTER)
+  }
+
+  //todo: retrieve eid_client and confirm to-recipient has actually sent the original intro, for which this user is responding to
+  bool		lock_already_owned    = false;
+  unsigned long sesn_call_flags	=	(CALL_FLAG_LOCK_SESSION|CALL_FLAG_LOCK_SESSION_BLOCKING|
+                                     CALL_FLAG_HASH_SESSION_LOCALLY|CALL_FLAG_HASH_UID_LOCALLY| CALL_FLAG_HASH_USERNAME_LOCALLY|
+                                     CALL_FLAG_ATTACH_FENCE_LIST_TO_SESSION|CALL_FLAG_REMOTE_SESSION);
+
+//  GetSessionForThisUserByUserId(sesn_ptr, UfsrvUidGetSequenceId((UfsrvUid *)user_ptr->ufsrvuid.data), &lock_already_owned, sesn_call_flags);
+  GetSessionFromUserHandle(AS_CARRIER_SESSION(sesn_ptr), record_ptr->to, &lock_already_owned, sesn_call_flags);
+  InstanceHolderForSession *instance_sesn_ptr_target = (InstanceHolderForSession *)SESSION_RESULT_USERDATA(sesn_ptr);
+
+  if (unlikely(IS_EMPTY(instance_sesn_ptr_target))) {
+    _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_PROG_NULL_POINTER)
+  }
+
+  //sesn_ptr_target locked
+
+  Session *sesn_ptr_target = SessionOffInstanceHolder(instance_sesn_ptr_target);
+
+  UfsrvEvent event = {0};
+  RegisterUfsrvEvent(sesn_ptr, EVENT_TYPE_USER_INTRO, MESSAGE_COMMAND__COMMAND_TYPES__INTRO_USER_RESPONSE, NULL, &event);//note eid is being generated for the user who accepted ie this session (not target)
+
+  if (SESSION_RESULT_TYPE_SUCCESS(sesn_ptr)) {
+    InterBroadcastUserMessage(sesn_ptr, CLIENT_CTX_DATA(msgcmd_ptr), (FenceEvent *) &event, msgcmd_ptr->header->args);
+
+    _MarshalIntroMessageUserResponse(ctx_sesn_ptr, instance_sesn_ptr_target, wsm_ptr_received, data_msg_ptr, &event);
+
+    if (!lock_already_owned) SessionUnLockCtx(THREAD_CONTEXT_PTR, sesn_ptr_target, __func__);
+
+    return SESSION_RESULT_PTR(sesn_ptr);
+  } else {
+    //todo: return attachment error to user
+  }
+
+  if (!lock_already_owned) SessionUnLockCtx(THREAD_CONTEXT_PTR, sesn_ptr_target, __func__);
+
+  _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_PROG_NULL_POINTER)
+}
