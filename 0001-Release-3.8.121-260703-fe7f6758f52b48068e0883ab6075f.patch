+ * @return pointer to newly allocated and copied string
+ */
+char *
+strbufdup(const char *s, size_t n)
+{
+  if (!IS_EMPTY(s)) {
+    char *copy = malloc(n + 1);
+    if (copy) {
+      memcpy(copy, s, n);
+      copy[n] = 0;
+    }
+    return copy;
+  }
 
