+#define SQL_INSERT_NEW_INCOMING_MESSAGE "INSERT INTO messages (id_events, fid, type, rawmsg, timestamp, originator, originator_device) VALUES ('%lu', '%lu', '%u', '%s', '%lu', '%lu', '%d')"
+
+  char *sql_query_str;
