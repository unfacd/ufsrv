+/**
+ * 	@lock LockingLru:
+ * 	@unlocks LockingLru:
+ */
+LruClientData *
+LockingLruRearItemGet(LockingLru *lru_ptr)
+{
+	SPIN_LOCK()
+	DoublyListNode *list_node_ptr = DoublyListLast(&lru_ptr->list);
+	SPIN_UNLOCK()
+
+	if (IS_PRESENT(list_node_ptr)) {
+		return (_LruItemFromListNode(list_node_ptr))->data;
+	}
+
+	return NULL;
+
+}
