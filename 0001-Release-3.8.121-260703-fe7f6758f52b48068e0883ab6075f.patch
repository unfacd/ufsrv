+void udp_read(struct udp_sock *us, int fd)
+{
+  //AA+
+  if (fd == -1) fd = us->fd;
+	struct mbuf *mb = mbuf_alloc(us->rxsz);
+	struct sa src;
+	struct le *le;
+	int err = 0;
+	ssize_t n;
+
+	if (!mb) {
+		return;
+	}
+
+	src.len = sizeof(src.u);
+	n = recvfrom(fd, BUF_CAST mb->buf + us->rx_presz,
+		     mb->size - us->rx_presz, 0,
+		     &src.u.sa, &src.len);
+	if (n < 0) {
+		err = errno;
+		syslog(LOG_DEBUG, "%s (errno:'%d'): ERROR RECVFROM: %s", __func__, errno, strerror(errno) );
+		if (EAGAIN == err)
+			goto out;
+
+#ifdef EWOULDBLOCK
+		if (EWOULDBLOCK == err)
+			goto out;
+#endif
+
+#if TARGET_OS_IPHONE
+		if (ENOTCONN == err) {
+
+			struct udp_sock *us_new;
+			struct sa laddr;
+
+			err = udp_local_get(us, &laddr);
+			if (err)
+				goto out;
+
+			if (-1 != us->fd) {
+				fd_close(us->fd);
+				(void)close(us->fd);
+				us->fd = -1;
+			}
+
+			if (-1 != us->fd6) {
+				fd_close(us->fd6);
+				(void)close(us->fd6);
+				us->fd6 = -1;
+			}
+
+			err = udp_listen(&us_new, &laddr, NULL, NULL);
+			if (err)
+				goto out;
+
+			us->fd  = us_new->fd;
+			us->fd6 = us_new->fd6;
+
+			us_new->fd  = -1;
+			us_new->fd6 = -1;
+
+			mem_deref(us_new);
+
+			udp_thread_attach(us);
+
+			goto out;
+		}
+#endif
+		if (us->eh)
+			us->eh(err, us->arg);
+
+		goto out;
+	}
+
+	mb->pos = us->rx_presz;
+	mb->end = n + us->rx_presz;
+
+	(void)mbuf_resize(mb, mb->end);
+
+	syslog(LOG_DEBUG, "%s (bytes:'%lu': Received bytes: CALLING HELPER...", __func__ , n);
+	/* call helpers */
+	le = us->helpers.head;
+	while (le) {
+		struct udp_helper *uh = le->data;
+		bool hdld;
+
+		le = le->next;
+
+		hdld = uh->recvh(&src, mb, uh->arg);
+		if (hdld)
+			goto out;
+	}
+
+	us->rh(&src, mb, us->arg);
+
+ out:
+	mem_deref(mb);
+}
