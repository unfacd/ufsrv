-	uintptr_t p = (uintptr_t)LOCKINGLRU_EXTRACT_ITEM(lru_ptr, data);
-	p -= sizeof(uintptr_t);
-
-	LockingLruItem **lru_item_save = (LockingLruItem **)p;
