+//uint16_t sa_port(const struct sa *sa)
+uint16_t NetworkSocketAddressGetPort (const NetworkSocketAddress *sa)
+{
+	if (!sa)
+		return 0;
+
+	switch (sa->u.sa.sa_family)
+	{
+		case AF_INET:
+			return ntohs(sa->u.in.sin_port);
+
+		case AF_INET6:
+			return ntohs(sa->u.in6.sin6_port);
+
+		default:
+			return 0;
+	}
