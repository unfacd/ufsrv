+static void udp_timeout_handler(void *arg)
+{
+	struct dns_query *q = arg;
+	int err = ETIMEDOUT;
+
+	if (q->ntx >= NTX_MAX)
+		goto out;
+
+	err = send_udp(q);
+	if (err)
+		goto out;
+
+	tmr_start(&q->tmr, 1000<<MIN(2, q->ntx - 2),
+		  udp_timeout_handler, q);
+
+ out:
+	if (err) {
+		query_handler(q, err, NULL, NULL, NULL, NULL);
+		mem_deref(q);
+	}
+}
