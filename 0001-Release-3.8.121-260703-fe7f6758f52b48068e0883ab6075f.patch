+__pure static size_t
+_CalculateTopicsStringSize (CollectionDescriptor *collection_topics)
+{
+	size_t total_sz = 0;
+
+	for (size_t i=0; i<collection_topics->collection_sz; i++)	total_sz+=strlen((const char *)collection_topics->collection[i]);
+
+	return total_sz;
+}
