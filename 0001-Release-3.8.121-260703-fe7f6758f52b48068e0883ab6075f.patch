+{
+
+  BasicAuthDescriptor  *basic_auth_pr = (LruClientData *)FindLruItemWithMatcherAndDelink(&BasicAuthLruCache, _LruCacheMatchUserId, AS_LRU_CLIENT_DATA(&(BasicAuthDescriptor ){.userid=userid}));
