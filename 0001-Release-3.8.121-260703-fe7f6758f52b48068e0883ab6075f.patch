+#include <uflib/utils_time.h>
+__pure inline static bool
+IsRevokedMessageTimingThresholdLapsed(long long when_sent)
+{
+  if (GetTimeNowInMillis() - when_sent >= DAY_TO_MILLI_SECONDS(1)) return true;
+
+  return false;
+}
+
+/**
+ * @brief Currently only one reported message per command is processed. Reported message command will increment the fence eid.
+ * User's eid won't be affected. Even though fence eid is incremented, current implementation does not lodge an event record for this. Only original
+ * message's eid is being remembered.
+ * @param cmd_base_ctx
+ * @param command_marshaller
+ * @param call_flags
+ * @return
+ */
+static UFSRVResult *
+_IsUserAllowedToRevokeMessage(CommandBaseContext *cmd_base_ctx, CommandMarshallerCallback command_marshaller, unsigned long call_flags)
+{
+  unsigned rescode = RESCODE_PROG_NULL_POINTER;
+  bool fence_lock_already_owned = false;
+  Fence *f_ptr = NULL;
+  MessageCommandContext *cmd_ctx_ptr = (MessageCommandContext *) cmd_base_ctx;
+  MessageCommand	*msgcmd_ptr = cmd_ctx_ptr->command_base_context.data_msg_ptr_received->ufsrvcommand->msgcommand;
+  RevokedMessageRecord *revoked_message_ptr_received = msgcmd_ptr->revoked[0];
+
+  if (revoked_message_ptr_received->gid > 0 && revoked_message_ptr_received->when_sent > 0) {
+    if (IsRevokedMessageTimingThresholdLapsed(revoked_message_ptr_received->when_sent)) {
+      rescode = RESCODE_TIME_THRESHOLD_LAPSED;
+      syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p', gid:'%lu', when_sent:'%lu'}: ERROR: THRESHOLD LAPSED FOR MESSAGE..", __func__, pthread_self(), THREAD_CONTEXT_PTR, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), revoked_message_ptr_received->gid, revoked_message_ptr_received->when_sent);
+      goto return_error;
+    }
+
+    UfsrvEventDescriptor event_descriptor = {0};
+    DbBackendGetEventDescriptorByGid((event_descriptor.ufsrv_event.gid=revoked_message_ptr_received->gid, &event_descriptor));
+    if (THREAD_CONTEXT_UFSRV_RESULT_IS_SUCCESS_WITH_BACKEND_DATA) {
+      if (event_descriptor.status == EVENT_STATUS_REVOKED) {
+        syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p', gid:'%lu'}: ERROR: MESSAGE ALREADY REVOKED..", __func__, pthread_self(), THREAD_CONTEXT_PTR, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), revoked_message_ptr_received->gid);
+        rescode = RESCODE_MESSAGE_REVOKED;
+        goto return_error;
+      }
+
+      unsigned long userid_originator = UfsrvUidGetSequenceId(&SESSION_UFSRVUIDSTORE(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr)));
+      if (userid_originator != event_descriptor.userid_originator) {
+        syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p', gid:'%lu', userid_originator:'%lu', stored_userid_originator:'%lu'}: ERROR: NO PERMISSION TO REVOKE MESSAGE", __func__, pthread_self(), THREAD_CONTEXT_PTR, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), revoked_message_ptr_received->gid, userid_originator, event_descriptor.userid_originator);
+        rescode = RESCODE_BACKEND_RESOURCE_OWNER;
+        goto return_error;
+      }
+
+      _FIND_FENCE(event_descriptor.ufsrv_event.ctx_id);
+      //fence locked
+
+      FenceEvent fence_event = {0};
+      if (IS_EMPTY((RegisterFenceEvent(f_ptr, EVENT_TYPE_MSG_REVOKED, NULL, 0, &fence_event)))) {
+        rescode = RESCODE_FENCE_EVENT_GENERATION; goto return_unlock_fence;
+      }
+
+      fence_event.originator_ptr  = &SESSION_UFSRVUIDSTORE(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr));
+      fence_event.session_id	    =	SESSION_ID(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr));
+      InstanceContextForFence fence_context = {.instance_f_ptr=instance_f_ptr, .f_ptr=f_ptr, .is_locked=true, .lock_already_owned=fence_lock_already_owned};
+      cmd_ctx_ptr->command_base_context.event_ptr = (UfsrvEvent *)&fence_event;
+      cmd_ctx_ptr->marshaller_context.ctx_f_ptr = &fence_context;
+
+      int result = DbBackendUpdateEventStatus(event_descriptor.ufsrv_event.gid, EVENT_STATUS_REVOKED);
+
+      if (result != H_OK) {
+        syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p', gid:'%lu'}: ERROR: COULD NOT CHANGE EVENT STATUS...", __func__, pthread_self(), THREAD_CONTEXT_PTR, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr),revoked_message_ptr_received->gid);
+
+        rescode = RESCODE_BACKEND_RESOURCE_NULL; goto return_unlock_fence;
+      }
+
+      if (IsFencePublic(f_ptr)) {
+        if (DbBackendUpdateMessageStatus(event_descriptor.ufsrv_event.gid, 0, EVENT_STATUS_REVOKED) != H_OK) {
+          syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p', gid:'%lu'}: ERROR: COULD NOT CHANGE MESSAGE STATUS: IS MESSAGE DELETED ALREADY?", __func__, pthread_self(), THREAD_CONTEXT_PTR, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), revoked_message_ptr_received->gid);
+          //keep going...
+        }
+      }
+
+      DbBackendInsertUfsrvEvent((UfsrvEvent *)&fence_event);
+
+      revoked_message_ptr_received->fid = FENCE_ID(f_ptr); revoked_message_ptr_received->has_fid = 1;
+      InterBroadcastUserMessageRevoked((CommandBaseContext *)cmd_ctx_ptr, COMMAND_ARGS__ADDED);//update to COMMAND_ARGS__POSTED
+
+      //todo use db transaction
+      if (IS_PRESENT(command_marshaller)) {
+        INVOKE_COMMAND_MARSHALLER(command_marshaller, cmd_base_ctx);
+      }
+
+      if (fence_context.is_locked && !fence_context.lock_already_owned) {
+        FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, f_ptr, SESSION_RESULT_PTR(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr)));
+      }
+
+        _RETURN_RESULT_SESN(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), NULL, RESULT_TYPE_SUCCESS, rescode)
+      }
+    } else {
+      syslog(LOG_DEBUG, "%s {pid:'%lu', th_ctx:'%p', o:'%p', gid:'%lu'}: ERROR: COMMAND CONTAINED INVALID GID...", __func__, pthread_self(), THREAD_CONTEXT_PTR, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), revoked_message_ptr_received->gid);
+      goto return_error;
+    }
+
+  return_unlock_fence:
+  if (!fence_lock_already_owned)  FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, f_ptr, SESSION_RESULT_PTR(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr)));
+
+  return_error:
+  _RETURN_RESULT_SESN(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), NULL, RESULT_TYPE_ERR, rescode)
+}
+
+static UFSRVResult *
+_MarshalMessageRevoked(CommandBaseContext *cmd_base_ctx)
+{
+  MessageCommandContext *cmd_ctx_ptr = (MessageCommandContext *) cmd_base_ctx;
+  MessageCommand	*msgcmd_ptr = CMDCTX_DATA_MESSAGE(cmd_ctx_ptr)->ufsrvcommand->msgcommand;
+  RevokedMessageRecord *revoked_messaged_record_ptr_received = msgcmd_ptr->revoked[0];
+
+  _GENERATE_MESSAGECOMMAND_ENVELOPE_INITIALISATION();
+  _PrepareMarshalMessageForUserMessage(&envelope_marshal, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), NULL, CMDCTX_EVENT(cmd_ctx_ptr), CMDCTX_DATA_MESSAGE(cmd_ctx_ptr), MESSAGE_COMMAND__COMMAND_TYPES__REVOKE, COMMAND_ARGS__ACCEPTED);
+
+  RevokedMessageRecord *revoked_message_records[1];
+  RevokedMessageRecord revoked_message_record = REVOKED_MESSAGE_RECORD__INIT;
+  revoked_message_records[0] = &revoked_message_record;
+  message_command.revoked = revoked_message_records; message_command.n_revoked = 1;
+
+  revoked_message_record.gid = revoked_messaged_record_ptr_received->gid;
+  revoked_message_record.when_sent = revoked_messaged_record_ptr_received->when_sent; revoked_message_record.has_when_sent = 1;
+  ProvideUfsrvUidInProto((UfsrvUid *)&SESSION_UFSRVUIDSTORE(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr)), &revoked_message_record.author, PROTO_USER_RECORD_BYREF); revoked_message_record.has_author = 1;
+  message_command.originator = ProvideUserRecordFromSessionInProto(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), &user_record_originator, PROTO_USER_RECORD_MINIMAL, PROTO_USER_RECORD_BYREF);
+
+  _MarshalMessageCommandResponseToUser(CMDCTX_SESN_CTX_ORIGINATOR(cmd_ctx_ptr), NULL, CMDCTX_WSM(cmd_ctx_ptr), &command_envelope);
+
+  FenceRawSessionList raw_session_list = {0};
+  GetRawMemberUsersListForFence(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), CMDCTX_MSG_FENCE_INSTANCE(cmd_ctx_ptr), FENCE_CALLFLAG_INCLUDE_REMOTE_SESSIONS, &raw_session_list);//no locking
+  if (!CMDCTX_MSG_FENCE_LOCK_OWNED(cmd_ctx_ptr))	{
+    FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, CMDCTX_MSG_FENCE(cmd_ctx_ptr), SESSION_RESULT_PTR(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr)));
+    CMDCTX_MSG_FENCE_LOCKED_STATE_SET_FALSE(cmd_ctx_ptr);
+  }
+
+  if (raw_session_list.sessions_sz > 0) {
+    envelope_marshal.header->args = COMMAND_ARGS__SYNCED;
+
+    for (size_t i = 0; i < raw_session_list.sessions_sz; i++) {
+      Session *sesn_ptr_listed = SessionOffInstanceHolder(raw_session_list.sessions[i]);
+      if (SESSION_ID(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr)) == SESSION_ID(sesn_ptr_listed)) continue; //skip self
+
+#if 0
+      //todo do we block originator if on blocked list of target user
+      if (IsUserOnShareListBlocked(sesn_ptr_listed, CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr))) {
+        syslog (LOG_ERR, "%s {pid:'%lu', o:'%p', cid:'%lu', o_blocking:'%p', cid_blocked:'%lu'} ERROR: BLOCKED BY USER...", __func__, pthread_self(), CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr), SESSION_ID(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr)), sesn_ptr_listed, SESSION_ID(sesn_ptr_listed));
+        continue;
+      }
+#endif
+      _MarshalMessageCommandResponseToUser(CMDCTX_SESN_CTX_ORIGINATOR(cmd_ctx_ptr), raw_session_list.sessions[i], CMDCTX_WSM(cmd_ctx_ptr), &command_envelope);
+    }
+
+    DestructFenceRawSessionList(&raw_session_list, false);
+  }
+
+  return SESSION_RESULT_PTR(CMDCTX_SESN_ORIGINATOR(cmd_ctx_ptr));
+}
