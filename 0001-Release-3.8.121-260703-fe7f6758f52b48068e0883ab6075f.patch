+/**
+ * When using @param flag_by_ref don't lose scope of @param fence_key until the host prototype structure is destructed
+ * @param fence_key source key data
+ * @param proto_ptr host proto
+ * @param flag_by_ref when true pass value by reference.
+ */
+void
+ProvideFenceKeyInProto(unsigned char *fence_key, FenceRecord *fence_record, bool flag_by_ref)
+{
+  ProtobufCBinaryData *proto_ptr = &fence_record->fkey;
+
+  proto_ptr->len  = GROUP_MASTER_KEY_SIZE;
+  if (flag_by_ref) {
+    proto_ptr->data = fence_key;
+  } else {
+    proto_ptr->data = calloc(GROUP_MASTER_KEY_SIZE, sizeof(uint8_t));
+    memcpy(proto_ptr->data, fence_key, GROUP_MASTER_KEY_SIZE);
+  }
+
+  fence_record->has_fkey = 1;
+}
