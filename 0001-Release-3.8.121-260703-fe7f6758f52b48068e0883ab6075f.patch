+ * @dynamic_memory: EXPORTS Char *
+ */
+static char *
+_FormatGuardianRecordSpecs(GuardianRecordDescriptor *descriptor_ptr)
+{
+  char *guardian_specs_serialised = mdsprintf("{\"event_types\": [{\"type\":%u, \"fid\":%lu}]}", 0, 0UL);
+  return guardian_specs_serialised;
