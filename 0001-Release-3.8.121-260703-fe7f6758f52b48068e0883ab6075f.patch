+inline static UFSRVResult *
+_MarshalFenceDescriptionUpdate(InstanceContextForSession *ctx_ptr, InstanceHolderForFence *instance_f_ptr, WebSocketMessage *wsm_ptr_received, DataMessage *data_msg_ptr_recieved, unsigned long call_flags, FenceEvent *fence_event_ptr)
+{
