+{
+  bool is_rego_lock_set = false;
+  char *rego_lock = GetAccountRegistrationLock(username);
+  if (IS_STR_LOADED(rego_lock)) {
+    is_rego_lock_set = true;
+    if (IS_PRESENT(on_rego_set)) {
+      on_rego_set(rego_lock);
+    }
+    free(rego_lock);
+  }
+
+  return is_rego_lock_set;
+}
+
+/**
+ * @brief retrieve and match account's registration lock
+ * @param username[in] registration identifier
+ * @param rego_lock_provided[in] account holder provided rego lock to be matched
+ * @param registration_lock_state_ptr_provided[inout]
+ * @dynamic_memory EXPORTS 'RegistrationLockState *' if none was provided by user to hold result
+ * @return
+ */
+RegistrationLockState *
+MatchRegistrationLockIfSet(const char *username, const char *rego_lock_by_user, RegistrationLockState *registration_lock_state_ptr_provided)
+{
+  RegistrationLockState *registration_lock_state_ptr;
+
+  if (IS_EMPTY(registration_lock_state_ptr_provided)) {
+    registration_lock_state_ptr = calloc(1, sizeof(RegistrationLockState));
+  } else {
+    registration_lock_state_ptr = registration_lock_state_ptr_provided;
+  }
+
+  bool is_rego_lock_set   = false;
+  int not_identical_state = 1;
+
+  char *rego_lock_stored = GetAccountRegistrationLock(username);
+  if (IS_STR_LOADED(rego_lock_stored)) {
+    is_rego_lock_set = true;
+    if (IS_STR_LOADED(rego_lock_by_user)) {
+      not_identical_state = strncasecmp(rego_lock_by_user, rego_lock_stored, MEDIUMBUF);
+    }
+    free(rego_lock_stored);
+  }
+
+  registration_lock_state_ptr->is_set = is_rego_lock_set;
+  registration_lock_state_ptr->is_identical = not_identical_state? false : true;
+
+  return registration_lock_state_ptr;
+}
+
+/**
+ * 	@brief Look up the registration lock
+ * 	@return 0 on success
+ */
+int
+UpdateAccountRegistrationLock(unsigned long userid, const char *rego_lock)
+{
+  return DbAccountUpdateDataByText("kbs.rego_lock", rego_lock, userid);
+
+}
+
+/**
+ * 	@brief Look up the registration lock.
+ *
+ * 	This works early in the registration flow when the userid is still not known, hence look up using registration username.
+ * 	@param username registration id (email)
+ * 	@dynamic_memory EXPORTS char *
+ */
+char *
+GetAccountRegistrationPinHash(unsigned long userid)
+{
+  DbAccountDataUserAttributeGetText(userid, "kbs.argon2_hash");
+  if (THREAD_CONTEXT_UFSRV_RESULT_IS_SUCCESS_WITH_BACKEND_DATA) {
+    return ((char *)THREAD_CONTEXT_UFSRV_RESULT_USERDATA);
+  }
+
+  return NULL;
+
+}
+
+char * __attribute__((nonnull()))
+GetAccountRegistrationPinHashByUsername(const char *username)
+{
+  DbAccountDataAttributeGetTextByUsername(username, "kbs.argon2_hash");
+  if (THREAD_CONTEXT_UFSRV_RESULT_IS_SUCCESS_WITH_BACKEND_DATA) {
+    return ((char *)THREAD_CONTEXT_UFSRV_RESULT_USERDATA);
+  }
+
+  return NULL;
+
+}
