+static bool IsFenceOwnerInvitedBack(Session *sesn_ptr_inviter, UserRecord **user_records, unsigned long uid_owner, size_t invited_members_sz);
+
+/**
+ * @brief Users are allowed to invite fence owner back even if they don't have permissions to change fence membership state (as per rules codified below)
+ * @param sesn_ptr_inviter Target user that is being checked. Session must be locked.
+ * @param user_records collection of invited user records passed by inviter
+ * @param uid_owner uid of of fence owner
+ * @param invited_members_sz number of invited users on user_records collection
+ * @return true if fence owner invite-back rules are satisfied
+ */
+static bool __attribute__((nonnull(1, 2), access(read_only, 1),  access(read_only, 2)))
+IsFenceOwnerInvitedBack(Session *sesn_ptr_inviter, UserRecord **user_records, unsigned long uid_owner, size_t invited_members_sz)
+{
+  if (invited_members_sz == 1) {
+    const UserRecord *invited_user_record_ptr = user_records[0];
+    unsigned long userid_invited = UfsrvUidGetSequenceId((const UfsrvUid *) invited_user_record_ptr->ufsrvuid.data);
+    if (userid_invited == uid_owner) {
+      bool IsUserBlocked = IsUserOnShareList(sesn_ptr_inviter, userid_invited, SHARELIST_BLOCKED, CALLFLAGS_EMPTY);
+      if (!IsUserBlocked) return true;
+    }
+  }
+
+  return false;
+}
