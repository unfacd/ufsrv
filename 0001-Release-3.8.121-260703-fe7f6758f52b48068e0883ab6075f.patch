-				syslog(LOG_ERR, LOGSTR_WDELEG_WORKERREAD_ERR, __func__, pthread_self(), SESSION_ID(sesn_ptr_ipc), errno_this, amount_read, LOGCODE_WDELEG_WORKERREAD_ERR);
