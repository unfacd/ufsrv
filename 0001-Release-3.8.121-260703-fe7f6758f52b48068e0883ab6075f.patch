+#ifdef __UF_TESTING
+  syslog(LOG_DEBUG, "%s (pid:'%lu', th_ctx:'%p'): GENERATED SQL QUERY: '%s'", __func__, pthread_self(), THREAD_CONTEXT_PTR, sql_query_str);
+#endif
+  int sql_result = h_query_insert(THREAD_CONTEXT_DB_BACKEND, sql_query_str);
