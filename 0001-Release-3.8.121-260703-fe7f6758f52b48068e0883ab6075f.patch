+
+	void *obj_ptr_removed;
+	if (IS_PRESENT((obj_ptr_removed = hopscotch_remove_configurable(ht_ptr, obj_ptr)))) {
+		assert(obj_ptr_removed == obj_ptr);
+		return 0;
+	}
+
+	return_error:
+	return -1;
+
+}
+
