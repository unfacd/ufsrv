+//  _MarshalMessageCommandResponseToUser(ctx_sesn_ptr, NULL, wsm_ptr_received, &command_envelope);//todo we need to let user know of their updated eid
+
+  //only to user for whom response is targeted, revealing the ufsrvuid of the accepting party
