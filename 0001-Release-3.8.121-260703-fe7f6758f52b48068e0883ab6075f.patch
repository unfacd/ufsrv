+static void udp_destructor(void *data)
+{
+	struct udp_sock *us = data;
+
+	list_flush(&us->helpers);
+
+	if (-1 != us->fd) {
+//		fd_close(us->fd);//AA-
+		(void)close(us->fd);
+	}
+
+	if (-1 != us->fd6) {
+//		fd_close(us->fd6);//AA-
