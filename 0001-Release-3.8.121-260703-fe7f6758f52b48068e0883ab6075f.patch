+/**
+ * @Helper routine to extract fid from url path. This is a basic surface level validation.
+ * @param url_path_and_params full url path and parameters
+ * @param max_path_params_sz Maximum number of path tokens (seperated by '/')
+ * @param fid_param_idx the positional index (counting from 0) where fid is located on the supplied path
+ * @return -1 on error
+ */
+static long
+_GetValidateFidFromUrlParam(const char *url_path_and_params, unsigned int max_path_params_sz, unsigned int fid_param_idx)
+{
+  unsigned long fid = 0;
+
+  UrlParamsDescriptor url_params = {
+          .tokens = (UrlParamToken *[]){&(UrlParamToken){0}, &(UrlParamToken){0}, &(UrlParamToken){0}, &(UrlParamToken){0}}
+  };
+  TokeniseUrlParams((char *)url_path_and_params, &url_params, max_path_params_sz);
+
+  if (url_params.tokens_sz < 4) return fid;
+
+  if (IS_STR_LOADED(url_params.tokens[fid_param_idx]->token)) {
+    fid = strtoul(url_params.tokens[fid_param_idx]->token, NULL, 10);
+  }
+
+  return fid;
+}
