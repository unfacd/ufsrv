+	fence_command.originator = originator_ptr;//so they know who is leaving
+
+	//time_t		time_now	=	time(NULL);
+	ListEntry	*eptr		= 	NULL;
+
+	for (eptr=FENCE_USER_SESSION_LIST(f_ptr).head; eptr; eptr=eptr->next) {
