+ but WITHOUT ANY WARRANTY; without even the implied warranty of
+ MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ GNU Affero General Public License for more details.
+
+ You should have received a copy of the GNU Affero General Public License
+ along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+ */
+
+
+#include  <uflib/adt/adt_distinct_array.h>
+#include <string.h>
+#include <sys/syslog.h>
+
+static int _DistinctArrayPut(DistinctArray * _Nonnull hash_map_ptr, struct VariableBlockIndex **type_collection, uint8_t **block_storage, uint8_t *ufrvuid, size_t entry_sz);
+static int _DistinctArrayRemoveLast(DistinctArray * _Nonnull hash_map_ptr);
+
+int
+DistinctArrayPut(DistinctArray * _Nonnull distinct_array_ptr, struct VariableBlockIndex **type_collection, uint8_t **block_storage, uint8_t *ufrvuid, size_t entry_sz)
+{
+  if (IS_EMPTY(HashLookup(&distinct_array_ptr->hashTable, (void *)ufrvuid, true))) {
+    if (_DistinctArrayPut(distinct_array_ptr, type_collection, block_storage, ufrvuid, entry_sz) == 0) {
+      if (IS_PRESENT(AddToHash(&distinct_array_ptr->hashTable, ufrvuid))) {
+//        syslog(LOG_DEBUG, "%s: SUCCESS: ENTRY ADDED...", __func__);
+        distinct_array_ptr->hashTable.item_pretty_printer_callback(ufrvuid);
+        return 0;
+      } else {
+        syslog(LOG_DEBUG, "%s: ERROR: ENTRY NOT HashMapped... TODO: Remove from DistinctArray", __func__);
+//        _DistinctArrayRemoveLast(distinct_array_ptr);//todo remove from distinctarray
+        return 2; //hastable error
+      }
+    }
+  }
+
+  return 1; //hashmap error
+}
+
+static int
+_DistinctArrayPut(DistinctArray * _Nonnull hash_map_ptr, struct VariableBlockIndex **type_collection, uint8_t **block_storage, uint8_t *ufrvuid, size_t entry_sz)
+{
+  DistinctArrayDescriptor *hash_map_descriptor_ptr = &hash_map_ptr->distinct_array_descriptor;
+  size_t current_sz = *type_collection ? type_collection[0]->size : 0, incremented_sz = current_sz + 1;
+
+  if ((current_sz & incremented_sz) == 0) {
+    void *variable_array_allocated = realloc(*type_collection, sizeof **type_collection + ((current_sz + incremented_sz) * sizeof type_collection[0]->value_index[0]));
+    void *variable_storage_allocated = realloc(*block_storage, hash_map_descriptor_ptr->block_storage_unit_sz + ((current_sz + incremented_sz) * hash_map_descriptor_ptr->block_storage_unit_sz));
+    if (IS_EMPTY(variable_array_allocated) || IS_EMPTY(variable_storage_allocated)) {
+      return 1;
+    }
+
+    hash_map_descriptor_ptr->collection_allocated_sz = sizeof **type_collection + ((current_sz + incremented_sz) * sizeof type_collection[0]->value_index[0]);
+    hash_map_descriptor_ptr->block_allocated_sz = hash_map_descriptor_ptr->block_storage_unit_sz + ((current_sz + incremented_sz) * hash_map_descriptor_ptr->block_storage_unit_sz);
+
+    syslog(LOG_DEBUG, "--Allocating (current_sz:'%lu', incremented_sz:'%lu'): %lu bytes\n", current_sz, incremented_sz, hash_map_descriptor_ptr->collection_allocated_sz);
+    syslog(LOG_DEBUG, "--Allocating block size: %lu bytes, total slots available: '%lu'. \n", hash_map_descriptor_ptr->block_allocated_sz, hash_map_descriptor_ptr->block_allocated_sz / hash_map_descriptor_ptr->block_storage_unit_sz);
+    *type_collection = variable_array_allocated; // `stored_value_idx[0] = variable_array_allocated;`
+    *block_storage = variable_storage_allocated;
+  }
+
+  type_collection[0]->value_index[current_sz] = ufrvuid;
+  type_collection[0]->size = incremented_sz;
+  memcpy((uint8_t *)((*block_storage + hash_map_descriptor_ptr->storage_slot_offset)) + (hash_map_descriptor_ptr->block_storage_unit_sz * current_sz), ufrvuid, entry_sz);
+  syslog(LOG_DEBUG, "--Total slots used: '%lu'. Current slots available: '%lu, Total slots available: '%lu'. Address idx():'%p'\n", current_sz, (hash_map_descriptor_ptr->block_allocated_sz / hash_map_descriptor_ptr->block_storage_unit_sz) - current_sz, hash_map_descriptor_ptr->block_allocated_sz / hash_map_descriptor_ptr->block_storage_unit_sz, (uint8_t *)(*block_storage + hash_map_descriptor_ptr->storage_slot_offset) + (hash_map_descriptor_ptr->block_storage_unit_sz * current_sz));
+
+  return 0;
+}
+
+/**
+ * @brief Removal is only supported at the trailing end. No adjustment to allocation of storage
+ * @param hash_map_ptr
+ * @param type_collection
+ * @param block_storage
+ * @param ufrvuid
+ * @param entry_sz
+ * @return
+ */
+__unused static int
+_DistinctArrayRemoveLast(DistinctArray * _Nonnull hash_map_ptr)
+{
+  DistinctArrayDescriptor *hash_map_descriptor_ptr = &hash_map_ptr->distinct_array_descriptor;
+
+  if ((hash_map_ptr->stored_value_idx)) {
+    size_t current_sz = hash_map_ptr->stored_value_idx[0].size;
+    uint8_t **block_storage = (uint8_t **) &hash_map_ptr->value_block_storage;
+
+    hash_map_ptr->stored_value_idx[0].size = current_sz - 1;
+
+    //zero out slots
+    (hash_map_ptr->stored_value_idx[0].value_index[hash_map_descriptor_ptr->storage_slot_idx] = NULL);
+    memset((uint8_t *) ((*block_storage + hash_map_descriptor_ptr->storage_slot_offset)) + (hash_map_descriptor_ptr->block_storage_unit_sz * hash_map_descriptor_ptr->storage_slot_idx), '\0', hash_map_descriptor_ptr->block_storage_unit_sz);
+    hash_map_descriptor_ptr->storage_slot_idx--;
+
+    return 0;
+  }
+
+  return 1;
+}
+
+void
+DistinctArrayIterate(DistinctArray * _Nonnull hash_map_ptr, void(^on_item_available)(uint8_t *item))
+{
+  for (size_t i = 0; i < hash_map_ptr->stored_value_idx->size; i++) {
+    if (IS_PRESENT(hash_map_ptr->value_block_storage[i].value)) {
+      on_item_available((uint8_t *)hash_map_ptr->value_block_storage[i].value);
+    }
+  }
+}
+
+void
+DistinctArrayDestruct(DistinctArray * _Nonnull hash_map_ptr)
+{
+  HashTableDestruct(&hash_map_ptr->hashTable, !HASHTABLE_SELF_DESTRUCT);
+  free(hash_map_ptr->value_block_storage);
+  free(hash_map_ptr->stored_value_idx);
+}
