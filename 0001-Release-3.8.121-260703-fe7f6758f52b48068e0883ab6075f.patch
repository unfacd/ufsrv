+
+  syslog(LOG_ERR, "%s (pid:'%lu', userid:'%lu'): ERROR COULD NOT INVALIDATE BASICAUTH CACHE FOR USER: NO MATCH FOUND", __func__, pthread_self(), userid);
+
+  return 0;
+}
