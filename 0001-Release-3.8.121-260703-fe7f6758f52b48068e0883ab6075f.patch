diff --git a/src/ufsrvmsg_core/fence/fence_enums_type.h b/src/ufsrvmsg_core/fence/fence_enums_type.h
new file mode 100644
index 00000000..9ab8ec2f
--- /dev/null
+++ b/src/ufsrvmsg_core/fence/fence_enums_type.h
@@ -0,0 +1,79 @@
+/**
+ * Copyright (C) 2015-2025 unfacd works
