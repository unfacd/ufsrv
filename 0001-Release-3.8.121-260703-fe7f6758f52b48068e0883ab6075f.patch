+  {
+    unsigned char digest_raw[hmac_final_size+1];
+    memset(digest_raw, 0, sizeof(digest_raw));
+
+    syslog(LOG_DEBUG, "%s: {hmac_hex:'%s'}", __func__, hex_print(enc_ptr->hmac, hmac_final_size, digest_raw));
