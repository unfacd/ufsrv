+/**
+ * @brief Given a binary or otherwise data, encode it.
+ * @param data data to be encoded, binary or otherwise
+ * @param data_sz size of data to be encoded
+ * @param result_out user-allocated char buffer to hold the encoded information. User is responsible for correct sizing.
+ */
+void base64url_encode(const unsigned char *data, size_t data_sz, unsigned char *result_out)
+{
+  int i;
+  unsigned char *p = result_out;
+
+  for (i = 0; i < data_sz - 2; i += 3) {
+    *p++ = basis_64[(data[i] >> 2) & 0x3F];
+    *p++ = basis_64[((data[i] & 0x3) << 4) | ((int) (data[i + 1] & 0xF0) >> 4)];
+    *p++ = basis_64[((data[i + 1] & 0xF) << 2) | ((int) (data[i + 2] & 0xC0) >> 6)];
+    *p++ = basis_64[data[i + 2] & 0x3F];
+  }
+
+  if (i < data_sz) {
+    *p++ = basis_64[(data[i] >> 2) & 0x3F];
+    if (i == (data_sz - 1)) {
+      *p++ = basis_64[((data[i] & 0x3) << 4)];
+    } else {
+      *p++ = basis_64[((data[i] & 0x3) << 4) | ((int) (data[i + 1] & 0xF0) >> 4)];
+      *p++ = basis_64[((data[i + 1] & 0xF) << 2)];
+    }
+  }
+
+  *p++ = '\0';
+}
