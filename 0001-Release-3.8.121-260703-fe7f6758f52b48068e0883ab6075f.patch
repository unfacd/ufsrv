- */
-LruClientData *
-LockingLruSet (LockingLru *lru_ptr, Session *sesn_ptr, LruClientData *client_data_ptr)
-{
-	return (LockingLruPromote(lru_ptr, sesn_ptr, NULL, client_data_ptr));//technically not a promotion. NULL indicates a new item
