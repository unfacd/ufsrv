+/**
+ * @brief A user removed  from invite list (uninvited); either by inviter (e.g admin) or by invitee
+ * @param instance_sesn_ptr the requesting user, or invitee
+ */
+inline static UFSRVResult *
+_CommandControllerFenceInviteDeletedSet(InstanceHolderForSession *instance_sesn_ptr, WebSocketMessage *wsm_ptr_received, DataMessage *data_msg_ptr)
+{
+  InstanceHolderForFenceStateDescriptor *instance_fstate_ptr = NULL;
+  FenceStateDescriptor	                *fstate_ptr;
+  FenceCommand					                *fcmd_ptr = data_msg_ptr->ufsrvcommand->fencecommand;
+
+#define _FENCE_CALL_FLAGS_INVITE_DELETE	(FENCE_CALLFLAG_CHECK_FENCEOWNERSHIP|FENCE_CALLFLAG_KEEP_FENCE_LOCKED)
+
+  Session *sesn_ptr = SessionOffInstanceHolder(instance_sesn_ptr);
+  size_t collection_sz = 1;
+  FenceRecord  *fence_record;
+  if (fcmd_ptr->n_fences > 0 && IS_PRESENT(fcmd_ptr->fences)) {
+    fence_record = fcmd_ptr->fences[0];
+    if (IS_PRESENT(fence_record) && fence_record->n_invited_members > 0 && IS_PRESENT(fence_record->invited_members)) collection_sz = fence_record->n_invited_members;
+    else goto return_parameters_error;
+    if (collection_sz > CONFIGDEFAULT_FENCE_LIST_MAX_SZ) {
+      HandleFenceCommandError(&(InstanceContextForSession) {instance_sesn_ptr, sesn_ptr}, NULL, wsm_ptr_received,
+                              data_msg_ptr, RESCODE_FENCE_INVITATION_LIST, fcmd_ptr->header
+                                                                                   ->command, NULL);
+      _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_FENCE_INVITE_SIZE)
+    }
+  } else {
+    return_parameters_error:
+    HandleFenceCommandError(&(InstanceContextForSession) {instance_sesn_ptr, sesn_ptr}, NULL, wsm_ptr_received,
+                            data_msg_ptr, RESCODE_FENCE_MISSING_PARAM, fcmd_ptr->header
+                                                                               ->command, NULL);
+    _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, RESCODE_FENCE_MISSING_PARAM)
+
+  }
+
+  InstanceContextForFence instance_fence_ctx = {0};
+  UFSRVResult  results_uninvited[collection_sz]; memset(results_uninvited, '\0', sizeof(results_uninvited));
+  InstanceContextForSession sessions_uninvited[collection_sz]; memset(sessions_uninvited, '\0', sizeof(sessions_uninvited));
+  CollectionDescriptorPair uninvited_users_collection = {0};
+  uninvited_users_collection.first.collection			= AS_COLLECTION_TYPE(results_uninvited);
+  uninvited_users_collection.first.collection_sz	=	collection_sz;
+  uninvited_users_collection.second.collection		= AS_COLLECTION_TYPE(sessions_uninvited);
+  uninvited_users_collection.second.collection_sz	= collection_sz;
+  uninvited_users_collection.source.collection    = AS_COLLECTION_TYPE(fence_record->invited_members);
+  uninvited_users_collection.source.collection_sz	= collection_sz;
+
+  IsUserAllowedToRemoveInvitedUser(sesn_ptr,fcmd_ptr->fences[0]->fid, &instance_fence_ctx, AS_CONTEXT_DATA(&uninvited_users_collection), _FENCE_CALL_FLAGS_INVITE_DELETE);
+
+  //>>> FENCE SHOULD BE IN RW LOCKED STATE
+
+  Fence                                 *f_ptr          = instance_fence_ctx.f_ptr;
+  InstanceHolderForFence                *instance_f_ptr = instance_fence_ctx.instance_f_ptr;
+  for (size_t idx=0; idx<collection_sz; idx++) {
+    UFSRVResult *result = (UFSRVResult  *)(uninvited_users_collection.first.collection + (idx * sizeof(UFSRVResult)));
+    InstanceContextForSession *instance_sesn_ctx_uninvited = (InstanceContextForSession *)(uninvited_users_collection.second.collection + (idx * sizeof(InstanceContextForSession)));
+    if (result->result_type == RESULT_TYPE_SUCCESS) {
+      instance_sesn_ctx_uninvited->sesn_ptr = SessionOffInstanceHolder(instance_sesn_ctx_uninvited->instance_sesn_ptr);
+
+      SessionLockRWCtx(THREAD_CONTEXT_PTR, instance_sesn_ctx_uninvited->sesn_ptr, _LOCK_TRY_FLAG_FALSE, __func__);
+      if (_RESULT_TYPE_EQUAL(THREAD_CONTEXT_UFSRV_RESULT(THREAD_CONTEXT), RESULT_TYPE_ERR)) {
+        continue;
+      }
+      instance_sesn_ctx_uninvited->is_locked = true;
+      instance_sesn_ctx_uninvited->lock_already_owned = (_RESULT_CODE_EQUAL(THREAD_CONTEXT_UFSRV_RESULT(THREAD_CONTEXT), RESCODE_PROG_LOCKED_BY_THIS_THREAD));
+
+      if (unlikely(IS_EMPTY((instance_fstate_ptr = IsUserMemberOfThisFence(SESSION_INVITED_FENCE_LIST_PTR(instance_sesn_ctx_uninvited->sesn_ptr), f_ptr, false)))))	{
+        HandleFenceCommandError(&(InstanceContextForSession) {instance_sesn_ptr,
+                                                              sesn_ptr}, &((FenceStateDescriptor) {.instance_holder_fence=instance_f_ptr}), wsm_ptr_received, data_msg_ptr, RESCODE_FENCE_MEMBERSHIP, fcmd_ptr->header->command, NULL);
+        if (!instance_sesn_ctx_uninvited->lock_already_owned) {
+          SessionUnLockCtx(THREAD_CONTEXT_PTR, instance_sesn_ctx_uninvited->sesn_ptr, __func__);
+          instance_sesn_ctx_uninvited->is_locked = false;
+        }
+        continue;
+      }
+
+      //sesn_uninvited WR LOCKED
+      fstate_ptr          = FenceStateDescriptorOffInstanceHolder(instance_fstate_ptr);
+      UfsrvUid uid_invited_by = {0};
+      memcpy(&uid_invited_by, &(fstate_ptr->invited_by), sizeof(UfsrvUid));
+
+      FenceEvent fence_event = {0};	fence_event.event_type = EVENT_TYPE_FENCE_USER_UNINVITED;
+      RemoveUserFromInvitedList(instance_sesn_ctx_uninvited->instance_sesn_ptr, fstate_ptr, &fence_event, FENCE_CALLFLAG_WRITEBACK_DATA_TO_BACKEND);
+
+      MarshalFenceInvitationDeleted(&(InstanceContextForSession){instance_sesn_ptr, sesn_ptr}, instance_sesn_ctx_uninvited, fstate_ptr, &instance_fence_ctx, &uid_invited_by, &fence_event, wsm_ptr_received, data_msg_ptr, FENCE_CALLFLAG_KEEP_FENCE_LOCKED);
+      if (!instance_sesn_ctx_uninvited->lock_already_owned) {
+        SessionUnLockCtx(THREAD_CONTEXT_PTR, instance_sesn_ctx_uninvited->sesn_ptr, __func__);
+      }
+    } else {
+        int 	rescode		=	SESSION_RESULT_CODE(sesn_ptr);
+
+        if (rescode != RESCODE_FENCE_DOESNT_EXIST) {
+          //FENCE LOCKED...
+          if (rescode == RESCODE_FENCE_OWNERSHIP) {
+  //        instance_f_ptr = (InstanceHolderForFence *)SESSION_RESULT_USERDATA(sesn_ptr);//this branch is not supported
+  //        f_ptr		=	FenceOffInstanceHolder(instance_f_ptr);
+  //
+  //        HandleFenceCommandError(&(InstanceContextForSession){instance_sesn_ptr, sesn_ptr}, fstate_ptr, wsm_ptr_received, data_msg_ptr, rescode, fcmd_ptr->header->command, NULL);
+          } else { //RESCODE_FENCE_MEMBERSHIP //user not on invite list
+            HandleFenceCommandError(&(InstanceContextForSession) {instance_sesn_ptr,
+                                                                  sesn_ptr}, &((FenceStateDescriptor) {.instance_holder_fence=instance_f_ptr}), wsm_ptr_received, data_msg_ptr, rescode, fcmd_ptr->header
+                                                                                                                                                                                                 ->command, NULL);
+          }
+
+          continue;
+        } else goto  return_with_error;//irrecoverable error
+
+        return_with_error:
+        _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_ERR, rescode)
+      }
+  }
+
+  return_unblock:
+  if (instance_fence_ctx.is_locked && !instance_fence_ctx.lock_already_owned)	FenceEventsUnLockCtx(THREAD_CONTEXT_PTR, f_ptr, SESSION_RESULT_PTR(sesn_ptr));
+  _RETURN_RESULT_SESN(sesn_ptr, NULL, RESULT_TYPE_SUCCESS, RECODE_NONE)
+
+#undef _FENCE_CALL_FLAGS_INVITE_DELETE
+}
