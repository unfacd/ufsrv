//Global table of opened Sockets
//ProtocolHeader is a placeholder to manage protocol specific run-time semantics, such as handshake
//details. Currently ProtocolHeaderWebsocket s implemented.
//As the server is multi protocol, to add a new protocol you may need to specifiy new one for a new protocol. 
//See Protocol description below 
//HeaderProtocolWebsocket current;y is used during WebSocket handshake process.
//
//Handshake:
//-I/O Loop (ThreadWebsocket) if handshake flag:	(protocol_websocket_thread.c)
	HandshakeWebsocket(sesnptr, ssptr)				(protocol_websocket_thread.c)
		len=recv(sock, handshake, 1024, MSG_PEEK);
		iterate over tokens and save in 'handshake'
		parse_handshake(sptr, handshake)			(protocol_websocket_routines.c)
			ProtocolHeaderWebsocket *headers = sptr->header;
			populate ProtocolHeaderWebsocket
		generate validation token and copy in ProtocolHeaderWebsocket *headers
		DispatchSocketBuffer (sesnptr, sptr, NULL);
		.
		.
		On error return -1				
		
struct Socket {
         time_t when;

         int type,
             sock,
             block_sz;
         unsigned flag;

         ssize_t sbytes,
                 rbytes;

         long hport, //remote port
              port; //local port

         char address[MAXHOSTLEN], //normally localhost
              haddress[MAXHOSTLEN]; //remote address
         void *index;  /* generic data place-holder */

         struct Socket *next;

#ifdef SOCKET_QUEUE
         long nMsg;
         SocketQueue *front,
                     *rear;
#else
		void *header; //ProtocolHeader[placeholder] a protocol specific may or may not be needed ProtocolHeaderWebSocket
		
         char msg[XLARGBUF];//raw read from the socket
		char msg_out2[XLARGBUF];//response message formatted by the recieivin socket
		char *msg_out; //dynamically allocated by the call back. this is what is sent back. should be implement in the queue struct->msg
         ssize_t msglen;
		size_t msg_out_len;
#endif
        };
 typedef struct Socket Socket;

 struct SocketsTable {
         int nEntries;
         Socket *head,
                *tail;
        };
 typedef struct SocketsTable SocketsTable;

