typedef struct Session {
          time_t when;

          unsigned long session_id;

          unsigned stat;  /* FIRING_DQUAD */

          Socket *dsptr; /* destination socket */
          Socket *ssptr; /* source socket */

          void *user_data; //RedirectionRegistery
          void *redirection_registry;
          void *session_service; //SessionService state information

		//unique per session
          pthread_t th;
		  pthread_attr_t th_attr;
          pid_t pid;
        //unique per session
         } Session;

