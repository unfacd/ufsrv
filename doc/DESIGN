//each Session defines a SessionService structure which contains data specific to the semnatics of the service being provided
//by the protocol and connection.
//SessionService and USer are instantiated and attached to host Session during Session creation process in user.c CreateUserSession()
//following successfull user handshake connection

	struct SessionServiceRequest {
			unsigned long 	server_req_id; //each request is earmarked with a sequence number
			unsigned long	client_req_id; //id supplied by the client
			time_t 			req_when;
			unsigned  		req_cmd_idx; //index into UFServerCommand
			unsigned 		req_status; //serviced|unserviced
			unsigned 		req_error_idx; //error string if any
			} ;
		typedef struct SessionServiceRequest SessionServiceRequest;

	struct SessionService {
			unsigned short	authentication_mode; //how did the user access the network

			UserBackendAccess user_backend_access;	//interface and semantics for accessing the backend currently used to isolate objects access the User Backend

			struct SessionServiceRequest *current_client_req_ptr; //current request by client
			struct SessionServiceRequest *current_server_req_ptr; //current request by server (the provider)

			Queue client_req_que_history; //we keep history of MAX_QUEUE_HSTORY of type ProtocolRequestWebsocket
			Queue server_req_que_history;

			struct User *u_ptr; //user attached to this session

			List session_user_fence_list; //list of fences joined by the user

			Queue session_user_message_queue; //messages produced by user irrespective of which fence
		};
	typedef struct SessionService SessionService;
	

